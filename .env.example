# Local process: listening address/port (export these in your shell).
# Compose: published host address/port; container always listens on 0.0.0.0:8000.
# Set APP_HOST=0.0.0.0 explicitly to allow LAN access.
APP_HOST=127.0.0.1
APP_PORT=8000

# Preliminary CPU tag; pin a verified ghcr.io/ggml-org/llama.cpp@sha256:... before acceptance.
# Images and models must be installed manually BEFORE runtime (pull_policy: never).
LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server
# Host file, relative to compose.yaml or absolute. Mounted read-only as /models/model.gguf.
LLM_MODEL_PATH=./models/Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# The same value is passed to llama-server --alias and completion request model.
LLM_MODEL_NAME=Qwen3-4B-Instruct-2507
# Origin without /v1; llm is reachable only within the Compose network.
LLM_BASE_URL=http://llm:8080
LLM_CONTEXT_SIZE=8192
LLM_THREADS=8
LLM_MAX_TOKENS=768

# Manual ingestion only. Export locally; Python does not load .env automatically.
# Supply the password through your environment/secret manager; never commit it.
WIKI_DB_HOST=
WIKI_DB_PORT=5432
WIKI_DB_NAME=
WIKI_DB_USER=chago_rag
WIKI_DB_PASSWORD=
WIKI_DB_VIEW=rag.rag_wikijs_pages_v1
WIKI_DB_TIMEOUT_SECONDS=30
WIKI_SOURCE_ORIGIN=
